{
 "schema": "sumeds-ontology-pack/0.1",
 "vocabulary": "ICD10PCS",
 "release": "fy2016-fy2027",
 "title": "ICD-10-PCS procedures and their 1- to 6-character prefixes, union of FY2016 to FY2027",
 "code_format": "OMOP concept_code: no dot, e.g. 0DTJ4ZZ; prefixes such as 0DTJ4",
 "columns": [
  "code",
  "description",
  "parent",
  "first_year",
  "last_year"
 ],
 "fields": {
  "code": "code",
  "description": "description",
  "parent": "parent"
 },
 "parent": "the code without its last character; 1-character sections are roots",
 "years": "first and last fiscal year whose release contains the code or prefix",
 "shard_key_length": 2,
 "description_path": {
  "max_code_length": 6,
  "separator": " @ ",
  "note": "Rows of 1 to 6 characters store only their own axis label (section, body system, operation, body part, approach, device). Their description is the labels of the code and its ancestors joined root first with the separator, e.g. 0DTJ4 = 'Medical and Surgical @ Gastrointestinal System @ Resection @ Appendix @ Percutaneous Endoscopic'."
 },
 "rows": 197789,
 "bytes": 13020948,
 "license": "ICD-10-PCS was developed for the Centers for Medicare & Medicaid Services (CMS), which maintains it and makes it available for public use (https://www.hl7.org/fhir/us/core/STU4/qa-hta.html); it is published at no cost and without a license agreement and contains no WHO content. Codes and table labels are redistributed here unchanged.",
